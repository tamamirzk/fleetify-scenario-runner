# Salin ke .env lalu isi. .env tidak di-commit.

# Server v2 lokal (web Vite + API). Alat ini menolak host selain localhost;
# jangan arahkan ke staging atau produksi.
FLEETIFY_WEB_URL=http://localhost:5173
# Bawaan: <FLEETIFY_WEB_URL>/api/v1 (lewat proxy Vite, cookie sesi ikut terbawa)
# FLEETIFY_API_URL=

# Akun admin platform v2 lokal milikmu (lihat how-to-run.md di repo v2).
# Dipakai untuk login sekali lalu impersonasi persona tenant.
OWNER_EMAIL=admin@example.com
OWNER_PASSWORD=ganti-dengan-password-lokal

# Tenant persona (seed MBL v2)
TENANT_SLUG=mbl

# Panel
RUNNER_PORT=4800
# 1 = panel selalu headless (tanpa jendela browser)
HEADLESS=

# Jendela headed: posisi "x,y" (mis. monitor kedua), slowMo Playwright (ms; bawaan 250 headed)
WINDOW_POS=
SLOWMO=
# Pengali tahanan saat headless (0..1; bawaan 0.15)
HEADLESS_HOLD=

# Berkas temuan dari tombol "Catat temuan" (relatif ke akar repo, tidak di-commit)
TEMUAN_FILE=docs/TEMUAN.md

# Tautan tiket di panel: <TICKET_URL><kode tiket>, mis. FMS-71
TICKET_URL=https://plane.forest-hub.id/fleetify/browse/

# Hanya untuk skenario sla-eskalasi: folder Backend server v2 yang sedang menyala
V2_BACKEND_DIR=

# Pemeriksaan (docs/PEMERIKSAAN.md): DB Postgres lokal server v2 yang sedang diuji, hanya dibaca
# (SELECT dalam transaksi READ ONLY). Pakai peran yang menembus RLS (nilai MIGRATE_DATABASE_URL
# di .env Backend); peran aplikasi (fleetify_app) tidak melihat baris tenant. Hanya host lokal.
# Kosong = dibaca dari <V2_BACKEND_DIR>/.env (MIGRATE_DATABASE_URL lalu DATABASE_URL); bila
# keduanya tidak ada, Pemeriksaan dilewati dengan status "tidak dikonfigurasi".
V2_DATABASE_URL=
